{
  "expo": {
    "name": "Snaply",
    "slug": "snaply",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "snaply",
    "newArchEnabled": true,
    "android": {
      "package": "com.snaply.app",
      "versionCode": 1,
      "intentFilters": [
        {
          "action": "SEND",
          "data": [
            {
              "mimeType": "image/*"
            }
          ],
          "category": [
            "DEFAULT"
          ]
        },
        {
          "action": "SEND_MULTIPLE",
          "data": [
            {
              "mimeType": "image/*"
            }
          ],
          "category": [
            "DEFAULT"
          ]
        }
      ]
    },
    "ios": {
      "bundleIdentifier": "com.snaply.app",
      "buildNumber": "1.0.0",
      "supportsTablet": true
    },
    "plugins": [
      "expo-status-bar"
    ]
  }
}
